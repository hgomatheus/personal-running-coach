# Gemini API (free tier - get from https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here

# Strava App Credentials (create at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# App secret key for token encryption (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# App base URL (used for Strava OAuth callback)
APP_BASE_URL=http://192.168.1.x:3000
